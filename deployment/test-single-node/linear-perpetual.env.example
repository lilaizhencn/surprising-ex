# Copy to /etc/surprising/linear-perpetual.env and chmod 600.
# This file is for the single-node test deployment only; keep secrets out of Git.
JAVA_HOME=/usr/lib/jvm/java-27-openjdk-amd64
RUNTIME_ROOT=/var/lib/surprising/linear-perpetual/runtime
POSTGRES_MODE=native
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=surprising_exchange
POSTGRES_USER=surprising
POSTGRES_PASSWORD=CHANGE_ME
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
AERON_CLUSTER_HOSTNAMES=127.0.0.1
AERON_EGRESS_HOSTNAME=127.0.0.1
CORE_AERON_BASE_DIR=/dev/shm/surprising-aeron
APP_AERON_DIR=/dev/shm/surprising-app-linear-perpetual
REALTIME_ENABLED=true
TRADE_EXPORT_ENABLED=true
REALTIME_ROUTER_PORT=9095
GATEWAY_JWT_SECRET=CHANGE_ME
MM_SYMBOL=BTC-USDT
GATEWAY_PRODUCT_TRANSFER_ENABLED=false

# Set this only when the index-price provider has a usable external source.
# Empty means the provider does not require a predeclared symbol set at startup.
PRICE_INDEX_REQUIRED_SYMBOLS=
