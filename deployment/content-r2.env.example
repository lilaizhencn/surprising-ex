# Exchange-only public media bucket. Never use Social / C2C / KYC credentials here.
GATEWAY_CONTENT_R2_ENABLED=true
GATEWAY_CONTENT_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
GATEWAY_CONTENT_R2_ACCESS_KEY_ID=
GATEWAY_CONTENT_R2_SECRET_ACCESS_KEY=
GATEWAY_CONTENT_R2_BUCKET=surprising-ex-public
GATEWAY_CONTENT_R2_PUBLIC_BASE_URL=https://ex-cdn.tokdou.com
