            "description": "必需协议未发布或存储不可用"
          }
        },
        "description": "multipart file：JPEG/PNG/GIF/WebP ≤20 MiB，MP3/M4A/WAV ≤32 MiB，MP4 ≤64 MiB；检查 MIME 与文件头。私有 C2C/KYC 附件禁止上传。",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
