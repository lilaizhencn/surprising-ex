    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "LegalAcceptance": {
        "name": "X-Legal-Acceptance",
        "in": "header",
        "required": false,
        "description": "注册/认证/刷新携带；例如 29:ar-SA,30:ar-SA。最多512字符、10项，不允许重复ID，必须是当前必需修订。Web/Admin 仍遵循既有独立 Cookie/CSRF 协议。",
        "schema": {
          "type": "string",
          "maxLength": 512
        }
      },
      "AdminApproval": {
        "name": "X-Admin-Approval-Id",
        "in": "header",
        "required": true,
        "description": "既有审批流程批准且与本次方法、路径、查询和原始请求体哈希匹配的审批单。",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "LegalTranslation": {
        "type": "object",
        "required": [
          "locale",
          "title",
          "bodyHtml"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en-US",
              "zh-CN",
              "zh-TW",
              "es-ES",
              "fr-FR",
              "de-DE",
              "pt-BR",
              "ru-RU",
              "ar-SA",
              "ja-JP",
              "ko-KR",
              "hi-IN"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "bodyHtml": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64000,
            "description": "清洗后的允许列表 HTML，正文最多 60000 字。后台媒体是 /api/v1/content/media/{uuid}；公开响应解析为限定 CDN 地址。"
          }
        }
      },
      "LegalRevisionRow": {
        "type": "object",
        "required": [
          "revisionId",
          "type",
          "revisionLabel",
          "status",
          "version",
          "createdAt",
          "updatedAt",
          "publishedAt"
        ],
        "properties": {
          "revisionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          },
          "type": {
            "type": "string",
            "enum": [
              "USER_AGREEMENT",
              "PRIVACY_POLICY",
              "COOKIE_POLICY",
              "TRADING_RISK",
              "DERIVATIVES_RISK",
              "FUNDS_AND_WITHDRAWALS",
              "FEES",
              "AML_KYC",
              "COMPLAINTS",
              "SECURITY_NOTICE"
            ]
          },
          "revisionLabel": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "SUPERSEDED",
              "WITHDRAWN"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "LegalRevision": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LegalRevisionRow"
          },
          {
            "type": "object",
            "required": [
              "translations"
            ],
            "properties": {
              "translations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "$ref": "#/components/schemas/LegalTranslation"
                }
              }
            }
          }
        ]
      },
      "LegalSave": {
        "type": "object",
        "required": [
          "type",
          "revisionLabel",
          "translations"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "USER_AGREEMENT",
              "PRIVACY_POLICY",
              "COOKIE_POLICY",
              "TRADING_RISK",
              "DERIVATIVES_RISK",
              "FUNDS_AND_WITHDRAWALS",
              "FEES",
              "AML_KYC",
              "COMPLAINTS",
              "SECURITY_NOTICE"
            ]
          },
          "revisionLabel": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
          },
          "translations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "$ref": "#/components/schemas/LegalTranslation"
            }
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          }
        }
      },
      "LegalCommand": {
        "type": "object",
        "required": [
          "version",
          "reason"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "LegalDocument": {
        "type": "object",
        "required": [
          "revisionId",
          "type",
          "slug",
          "revisionLabel",
          "locale",
          "title",
          "bodyHtml",
          "registrationRequired",
          "publishedAt"
        ],
        "properties": {
          "revisionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          },
          "type": {
            "type": "string",
            "enum": [
              "USER_AGREEMENT",
              "PRIVACY_POLICY",
              "COOKIE_POLICY",
              "TRADING_RISK",
              "DERIVATIVES_RISK",
              "FUNDS_AND_WITHDRAWALS",
              "FEES",
              "AML_KYC",
              "COMPLAINTS",
              "SECURITY_NOTICE"
            ]
          },
          "slug": {
            "type": "string"
          },
          "revisionLabel": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en-US",
              "zh-CN",
              "zh-TW",
              "es-ES",
              "fr-FR",
              "de-DE",
              "pt-BR",
              "ru-RU",
              "ar-SA",
              "ja-JP",
              "ko-KR",
              "hi-IN"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "bodyHtml": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64000,
            "description": "清洗后的允许列表 HTML，正文最多 60000 字。后台媒体是 /api/v1/content/media/{uuid}；公开响应解析为限定 CDN 地址。"
          },
          "registrationRequired": {
            "type": "boolean"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Acceptance": {
        "type": "object",
        "required": [
          "revisionId",
          "locale"
        ],
        "properties": {
          "revisionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en-US",
              "zh-CN",
              "zh-TW",
              "es-ES",
              "fr-FR",
              "de-DE",
              "pt-BR",
              "ru-RU",
              "ar-SA",
              "ja-JP",
              "ko-KR",
              "hi-IN"
            ]
          }
        }
      },
      "ConsentStatus": {
        "type": "object",
        "required": [
          "documents",
          "missingRevisionIds"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalDocument"
            }
          },
          "missingRevisionIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
            }
          }
        }
      },
      "ContentUpload": {
        "type": "object",
        "required": [
          "mediaId",
          "url",
          "contentType",
          "size"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "/api/v1/content/media/{uuid}，供编辑器保存；公开文章响应为受限 CDN 地址。"
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LegalAudit": {
        "type": "object",
        "required": [
          "auditId",
          "revisionId",
          "action",
          "adminUserId",
          "reason",
          "snapshot",
          "createdAt"
        ],
        "properties": {
          "auditId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          },
          "revisionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          },
          "action": {
            "type": "string"
          },
          "adminUserId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "正整数 int64；JavaScript 必须无损解析为字符串。"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
