              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "$ref": "#/components/schemas/LegalDocument"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "无权限或账户被限制"
          },
          "404": {
            "description": "内容不存在"
          },
          "409": {
            "description": "修订或并发版本已变化"
          },
          "428": {
            "description": "LEGAL_CONSENT_REQUIRED 或管理员审批未完成；必须按 code 和请求路径区分"
          },
          "503": {
            "description": "必需协议未发布或存储不可用"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "en-US",
                "zh-CN",
                "zh-TW",
                "es-ES",
                "fr-FR",
                "de-DE",
                "pt-BR",
                "ru-RU",
                "ar-SA",
                "ja-JP",
                "ko-KR",
                "hi-IN"
