+    // Audit probes: a passing assertion reproduces the stated behavior, not security completion.
+    @Test void auditCommittedWithdrawalCanBeRejectedOnSameKeyRetryAfterReorgDeficit() {
+        var original=create("127.0.0.1");
+        String hash="0x"+"ab".repeat(32);
+        jdbc.update("update withdrawal_order set status='SENT',tx_hash=? where tenant_id=?",hash,tenant);
+        long depositId=jdbc.queryForObject("""
+                insert into deposit_record(tenant_id,chain,asset_symbol,tx_hash,to_address,amount,
+                    block_height,account_id) values (?,'ETH','ETH','audit-reorg-deposit',?,1,1,'withdraw-account') returning id
+                """,Long.class,tenant,address);
+        new CustodyReorgDeficitRepository(jdbc).open(tenant,custodyId,depositId,"ETH","ETH",
+                "withdraw-account",BigDecimal.ONE,BigDecimal.ONE);
+        var error=assertThrows(IllegalStateException.class,()->create("127.0.0.1"));
+        var response=new com.surprising.wallet.exception.CustodyExceptionHandler().state(error);
+        assertEquals(409,response.getStatusCode().value());
+        assertEquals("INVALID_STATE",((Map<?,?>)response.getBody().get("error")).get("code"));
+        assertEquals(1,count("withdrawal_order"));assertEquals(1,count("custody_withdrawal"));
+        assertEquals(original.id(),jdbc.queryForObject("select id from custody_withdrawal where tenant_id=?",UUID.class,tenant));
+        assertEquals("SENT",jdbc.queryForObject("select status from withdrawal_order where tenant_id=?",String.class,tenant));
+        assertEquals(0,BigDecimal.ONE.compareTo(balance("locked_balance")));
+    }
