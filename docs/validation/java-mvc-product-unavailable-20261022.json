  "native_boundary": "ProductUnavailableException只携带产品归属，无HTTP状态或请求类型。",
  "protocol_boundaries": [
    "普通Gateway Controller的ProductAvailabilityHttpAdvice。",
    "GatewayProxyController在响应与失败审计前转换；Binance保留-1000 JSON。",
    "GatewayProductSelection与ProductInternalHandlerMapping覆盖选择Handler之前的错误。",
    "C2cHttpErrors明确404/PRODUCT_NOT_ENABLED，并让失败审计分类同源。"
  ],
  "business_proof": [
    "六产品线原生ProductAccountAccess在取得AccountCommandGateway之前失败；未提交资金命令。",
    "六产品线真实资产HTTP拒绝运行时缺失，不错误返回零。",
    "六产品线本机维护HTTP拒绝且不产生审计意图或配置操作。",
    "真实PG质押拒绝后，原有种子质押/资金意图数量均保持，Core无调用。"
  ],
  "changed_error_behavior": "C2C泛型Runtime过去将产品不可用隐藏成500；现明确404/PRODUCT_NOT_ENABLED。WebSocket沿原错误帧处理原生业务消息，不再携带HTTP异常前缀。",
  "unverified": "其余29项深扫问题、共享嵌套模型/职责及最终真实六产品线网关/Core/做市/资金验收继续。",
  "cleanup": "所属PostgreSQL已停止删除；本批日志与Gateway汇总报告清理；保留构建产物。"
}
