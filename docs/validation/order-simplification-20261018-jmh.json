  "classpathRecipe": "合并 Core RuntimeStateBusinessRulesTest 与 Gateway OrderServiceTest 的 Surefire XML java.class.path，追加本机 Maven 缓存 JMH 1.37、jopt-simple、commons-math3；javac 以 jmh-generator-annprocess-1.37.jar 为 processorpath 编译以下 sources；JMH fork 沿用同一 classpath。",
  "sources": {
    "com/surprising/aeron/service/state/MarginSimplificationBenchmark.java": "package com.surprising.aeron.service.state;\n\nimport com.surprising.aeron.protocol.*;\nimport com.surprising.aeron.service.state.account.*;\nimport com.surprising.aeron.service.state.instrument.CoreInstrument;\nimport com.surprising.instrument.api.model.ContractType;\nimport com.surprising.product.api.ProductLine;\nimport java.util.concurrent.TimeUnit;\nimport org.openjdk.jmh.annotations.*;\n\n@State(Scope.Thread) @BenchmarkMode(Mode.AverageTime) @OutputTimeUnit(TimeUnit.NANOSECONDS)\n@Fork(value=1, jvmArgsAppend={\"-Xms256m\", \"-Xmx256m\", \"-XX:+UseG1GC\"})\npublic class MarginSimplificationBenchmark {\n    private TradingRuntimeState runtime;\n    private long key;\n    private boolean deposit;\n    private final AdjustPositionMarginCommand add = new AdjustPositionMarginCommand(\"1\", CoreMarginMode.ISOLATED, CorePositionSide.NET, 1);\n    private final AdjustPositionMarginCommand remove = new AdjustPositionMarginCommand(\"1\", CoreMarginMode.ISOLATED, CorePositionSide.NET, -1);\n    @Setup public void setup() {\n        var identities = new RuntimeIdentityRegistry();\n        runtime = RuntimeStateProjector.project(TradingCoreState.empty(ProductLine.LINEAR_PERPETUAL), identities);\n        var instrument = CoreInstrument.from(ProductLine.LINEAR_PERPETUAL,\n                new RegisterInstrumentCommand(\"1\", ContractType.LINEAR_PERPETUAL.ordinal(), \"BTC\", \"USDT\", \"USDT\",\n                        1, 1, 1, 100_000, 50_000, 0, 0, 0, -1, 0));\n        int symbol = identities.symbolId(\"1\"), asset = identities.assetId(\"USDT\");\n        key = identities.positionKey(7, instrument, CorePositionSide.NET);\n        runtime.putUser(new UserRuntime(ProductLine.LINEAR_PERPETUAL, 7, 0, CorePositionMode.ONE_WAY));\n        runtime.putBalance(new BalanceRuntime(7, asset, 1000, 100));\n        runtime.putPosition(key, new PositionRuntime(7, symbol, asset, CoreMarginMode.ISOLATED, CorePositionSide.NET,\n                instrument, 2, 100, 200, 0, 100));\n        runtime.clearChangedKeys();\n    }\n    @Benchmark public long adjust() {\n        deposit = !deposit;\n        DerivativeAccountCommandProcessor.adjustAccountPositionMargin(runtime, 7, key, deposit ? add : remove);\n        long margin = runtime.position(key).positionMarginUnits();\n        if (margin != (deposit ? 101 : 100)) throw new IllegalStateException(\"wrong margin\");\n        runtime.clearChangedKeys();\n        return margin;\n    }\n    @TearDown public void close() { runtime.close(); }\n}\n",
    "com/surprising/realtime/api/OrderPointSimplificationBenchmark.java": "package com.surprising.realtime.api;\n\nimport com.surprising.aeron.protocol.*;\nimport com.surprising.product.api.ProductLine;\nimport java.net.ServerSocket;\nimport java.util.*;\nimport java.util.concurrent.TimeUnit;\nimport org.openjdk.jmh.annotations.*;\nimport org.springframework.data.redis.connection.lettuce.LettuceConnectionFactory;\nimport org.springframework.data.redis.core.StringRedisTemplate;\n\n@State(Scope.Thread) @BenchmarkMode(Mode.AverageTime) @OutputTimeUnit(TimeUnit.MICROSECONDS)\n@Fork(value=1, jvmArgsAppend={\"-Xms256m\", \"-Xmx256m\", \"-XX:+UseG1GC\"})\npublic class OrderPointSimplificationBenchmark {\n    @Param({\"1\", \"100\"}) public int orders;\n    private Process server;\n    private LettuceConnectionFactory factory;\n    private ValkeyUserQueries queries;\n    @Setup public void setup() throws Exception {\n        int port;\n        try(var socket=new ServerSocket(0)) { port=socket.getLocalPort(); }\n        server = new ProcessBuilder(\"redis-server\", \"--bind\", \"127.0.0.1\", \"--port\", \"\"+port,\n                \"--save\", \"\", \"--appendonly\", \"no\").redirectOutput(ProcessBuilder.Redirect.DISCARD)\n                .redirectError(ProcessBuilder.Redirect.DISCARD).start();\n        factory = new LettuceConnectionFactory(\"127.0.0.1\",port);\n        factory.afterPropertiesSet(); factory.start();\n        var redis = new StringRedisTemplate(factory);\n        long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(10);\n        while(true) {\n            try(var connection=factory.getConnection()) { connection.ping(); break; }\n            catch(RuntimeException e) { if(System.nanoTime()>deadline) throw e; Thread.sleep(20); }\n        }\n        long now=System.currentTimeMillis();\n        var frames = new ArrayList<RealtimeFrame>();\n        frames.add(new RealtimeFrame(ProductLine.SPOT, RealtimeFrame.Kind.SNAPSHOT_BEGIN,42,100,0,now,1,\"\",\"\",new byte[0]));\n        frames.add(new RealtimeFrame(ProductLine.SPOT, RealtimeFrame.Kind.USER,42,100,1,now,1,\"\",\"user\",\n                CoreStateQueryCodec.encodeUserState(new CoreUserStateView(ProductLine.SPOT,42,1,List.of(),List.of(),List.of()))));\n        for(int i=1;i<=orders;i++) frames.add(new RealtimeFrame(ProductLine.SPOT, RealtimeFrame.Kind.ORDER,42,100,i+1,now,1,\"1\",\"\"+i,\n                CoreStateQueryCodec.encodeOrderState(new CoreOrderStateView(i,ProductLine.SPOT,42,\"1\",CoreOrderSide.BUY,100,2,0,2,false,\"OPEN\",1))));\n        frames.add(new RealtimeFrame(ProductLine.SPOT, RealtimeFrame.Kind.SNAPSHOT_END,42,100,orders+2,now,1,\"\",\"\",new byte[0]));\n        new ValkeyReadViewStore(redis).install(frames,now);\n        queries = new ValkeyUserQueries(redis);\n        if(!oldFullView().equals(pointOrder())) throw new IllegalStateException(\"different order\");\n    }\n    @Benchmark public CoreOrderStateView oldFullView() {\n        return queries.require(ProductLine.SPOT,42,null).openOrders().stream().filter(order->order.orderId()==1).findFirst().orElse(null);\n    }\n    @Benchmark public CoreOrderStateView pointOrder() { return queries.order(ProductLine.SPOT,42,1,null); }\n    @TearDown public void close() throws Exception {\n        if(factory!=null) factory.destroy();\n        if(server!=null) { server.destroy(); if(!server.waitFor(5,TimeUnit.SECONDS)) server.destroyForcibly(); }\n    }\n}\n"
  },
