# Standard single-member Aeron throughput baseline.
# Keep the defaults here aligned with the verified 256-window, 400k+ run.
# Individual qualification scripts may override a value through their public
# ASYNC_* environment variables, but must record the override in artifacts.

AERON_BASELINE_WINDOW="256"
AERON_BASELINE_WARMUP_SECONDS="30"
AERON_BASELINE_MEASURE_SECONDS="60"
AERON_BASELINE_GC="G1"
AERON_BASELINE_NODE_XMS="512m"
AERON_BASELINE_NODE_XMX="1536m"
AERON_BASELINE_CLIENT_XMS="128m"
AERON_BASELINE_CLIENT_XMX="512m"
AERON_BASELINE_ACCOUNT_LANES="4"
AERON_BASELINE_MATCHING_ENGINES="1"
AERON_BASELINE_BATCH_SIZE="20"
AERON_BASELINE_SYMBOLS="128"
AERON_BASELINE_TRADING_PROFILE="MIXED"
AERON_BASELINE_SETTLEMENT_WAIT_STRATEGY="BUSY_SPIN"
AERON_BASELINE_SETTLEMENT_SPIN_LIMIT="0"
AERON_BASELINE_MATCHER_WAIT_STRATEGY="BUSY_SPIN"
