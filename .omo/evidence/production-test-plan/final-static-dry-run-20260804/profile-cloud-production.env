profile=cloud-production
cpu_count=32
memory_mb=65536
max_provider_processes=64
jvm_heap_mb=4096
matching_jvm_heap_mb=3072
account_jvm_heap_mb=3072
margin_ops_jvm_heap_mb=3072
jvm_gc=g1
services=auto
stress_symbols=20
stress_users=5000
stress_concurrency=256
target_tps=3000
matching_kafka_concurrency=32
matching_engine_shards=16
matching_risk_shards=8
account_kafka_concurrency=32
risk_kafka_concurrency=8
matching_max_poll_records=1000
outbox_batch_size=1000
outbox_max_in_flight=128
account_outbox_max_in_flight=128
risk_outbox_max_in_flight=128
scale_factor=1
