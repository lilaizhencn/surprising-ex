profile=local-low
cpu_count=16
memory_mb=16384
max_provider_processes=8
jvm_heap_mb=512
matching_jvm_heap_mb=384
account_jvm_heap_mb=384
margin_ops_jvm_heap_mb=384
jvm_gc=g1
services=auto
stress_symbols=1
stress_users=100
stress_concurrency=4
target_tps=10
matching_kafka_concurrency=1
matching_engine_shards=1
matching_risk_shards=1
account_kafka_concurrency=1
risk_kafka_concurrency=1
matching_max_poll_records=100
outbox_batch_size=100
outbox_max_in_flight=32
account_outbox_max_in_flight=16
risk_outbox_max_in_flight=16
scale_factor=1
