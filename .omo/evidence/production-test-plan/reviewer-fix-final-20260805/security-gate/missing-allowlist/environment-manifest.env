profile=local-standard
cpu_count=16
memory_mb=16384
max_provider_processes=10
jvm_heap_mb=1024
matching_jvm_heap_mb=768
account_jvm_heap_mb=768
margin_ops_jvm_heap_mb=768
jvm_gc=g1
services=auto
stress_symbols=20
stress_users=1000
stress_concurrency=16
target_tps=50
matching_kafka_concurrency=4
matching_engine_shards=4
matching_risk_shards=2
account_kafka_concurrency=8
risk_kafka_concurrency=2
matching_max_poll_records=500
outbox_batch_size=500
outbox_max_in_flight=64
account_outbox_max_in_flight=32
risk_outbox_max_in_flight=32
scale_factor=1
