# Strict KEY=VALUE format. Values are data, never shell-evaluated.
PRODUCT_LINE=LINEAR_PERPETUAL
INTERVAL_SECONDS=1
SOURCE_TIMEOUT_SECONDS=3
MAX_CLOCK_SKEW_MS=500
ACTUATOR_URLS=gateway|http://127.0.0.1:9080/actuator/prometheus;trading|http://127.0.0.1:9084/actuator/prometheus;account|http://127.0.0.1:9086/actuator/prometheus
EXPORTER_URL=http://127.0.0.1:9191/metrics
CORE_URL=http://127.0.0.1:9192/metrics
KAFKA_LAG_COMMAND=/absolute/path/to/read-only-kafka-lag-adapter
POSTGRES_WATERMARK_COMMAND=/absolute/path/to/read-only-projector-watermark-adapter
AERONSTAT_COMMAND=/absolute/path/to/AeronStat-read-only-adapter
PROCESS_TARGETS=exporter|12345;core-0|12346;core-1|12347;core-2|12348
DISK_TARGETS=archive|/absolute/run/path/aeron/archive;kafka|/absolute/run/path/kafka;postgres|/absolute/run/path/postgres;outbox|/absolute/run/path/outbox
REQUIRED_ACTUATOR_NAMES=actuator-gateway,actuator-trading,actuator-account,exporter,core
REQUIRED_PROCESS_NAMES=exporter,core-0,core-1,core-2
REQUIRED_DISK_NAMES=archive,kafka,postgres,outbox
JCMD_BIN=jcmd
NMT_DIAGNOSTIC=false
