#!/usr/bin/env bash
set -euo pipefail

command_name="${1:?Kafka command name is required}"
shift
container_name="${KAFKA_DOCKER_CONTAINER:-rainbo-kafka}"

docker inspect "${container_name}" >/dev/null 2>&1 \
  || { echo "Kafka Docker container not found: ${container_name}" >&2; exit 1; }

if [[ "${command_name}" == "kafka-console-producer.sh" ]]; then
  exec docker exec -i "${container_name}" "/opt/kafka/bin/${command_name}" "$@"
fi
exec docker exec "${container_name}" "/opt/kafka/bin/${command_name}" "$@"
